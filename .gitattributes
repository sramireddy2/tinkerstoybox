* text=auto eol=lf

# Unity YAML: keep as text with LF so diffs stay readable
*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.mat     text eol=lf
*.meta    text eol=lf
*.anim    text eol=lf
*.controller text eol=lf
*.asmdef  text eol=lf
*.shader  text eol=lf
*.hlsl    text eol=lf
*.cs      text eol=lf diff=csharp

# Windows scripts
*.ps1     text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.ttf  binary
*.otf  binary
*.wav  binary
*.ogg  binary
